POSTGRES_USER: payment
POSTGRES_PASSWORD: payment
POSTGRES_DB: payment_db
RABBITMQ_DEFAULT_USER: payment
RABBITMQ_DEFAULT_PASS: payment

API_KEY=change-me-in-production

DATABASE_URL=postgresql+asyncpg://payment:payment@postgres/payment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

RABBITMQ_URL=amqp://payment:payment@rabbitmq/

# PAYMENTS_EXCHANGE=payments
# PAYMENTS_NEW_QUEUE=payments.new

GATEWAY_MIN_DELAY_SEC=2.0
GATEWAY_MAX_DELAY_SEC=5.0
GATEWAY_SUCCESS_RATE=0.90

WEBHOOK_TIMEOUT_SEC=5.0
WEBHOOK_MAX_RETRIES=3

OUTBOX_POLL_INTERVAL_SEC=1.0
