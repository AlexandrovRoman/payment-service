# Copy this file to .env and fill in real values for local development.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=payment-service
DEBUG=true

# Static API key for X-API-Key header
API_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payment_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://payment:payment@localhost:5672/

# Queue / exchange names (defaults work out of the box)
# PAYMENTS_EXCHANGE=payments
# PAYMENTS_NEW_QUEUE=payments.new
# PAYMENTS_DLQ=payments.new.dlq
# PAYMENTS_DLX=payments.dlx

# ── Payment gateway emulation ─────────────────────────────────────────────────
GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.90

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT=5.0
WEBHOOK_MAX_RETRIES=3

# ── Outbox ────────────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL=1.0
